[uwsgi]
socket = /srv/http/webpass-venv/webpass.sock
module = wsgi:app
chmod-socket = 664
# Exit if create_app() fails (for example a missing passwords.kdbx) instead of
# staying up with no application loaded.
need-app = true

## For Apache try:
# http-socket = 127.0.0.1:8080

uid = www-data
gid = www-data
